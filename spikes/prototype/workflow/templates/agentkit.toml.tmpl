# agentkit configuration. The process: .agentkit/workflow/WORKFLOW.md
# Agents may not edit this file (the guard denies it).

[kit]
version = "{{kit_version}}"
profile = "{{profile}}"
adapters = {{adapters}}
ci = "{{ci}}"
# Interpreter used by agent hooks and plugins.
python = "{{python}}"
self_hosted = {{self_hosted}}

[paths]
specs = "specs"
lock = "tests.lock.json"
unfreeze_log = "tests.unfreeze-log.md"
codemap = "docs/CODEMAP.md"
skills = ".agents/skills"
roles = "roles"

# Model tiers. Generic names apply to every tool; [models.<adapter>] tables override them.
# A tier left as "strong" / "standard" / "fast" means: inherit the tool's current model.
[models]
strong = "strong"
standard = "standard"
fast = "fast"

[models.claude-code]
strong = "opus"
standard = "sonnet"
fast = "haiku"

# [models.opencode]
# strong = "anthropic/claude-opus-5-5"
# standard = "anthropic/claude-sonnet-5-5"
# fast = "ollama/qwen3-coder"

[budgets]
agents_md_lines = 150
claude_md_lines = 40
skill_md_lines = 500
skill_description_chars = 200
rule_md_lines = 80
always_loaded_tokens = 3000

[guard]
deny_build_output_reads = true
# extra protected paths
deny_globs = []
ask_globs = []

# Override any profile value here, e.g.:
# [profile]
# test_cmd = "./gradlew --quiet test"
